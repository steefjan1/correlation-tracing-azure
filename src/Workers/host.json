{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "logging": {
    "logLevel": { "default": "Information", "Host.Results": "Information", "Azure.Core": "Warning", "Azure.Messaging": "Warning", "Azure.Identity": "Warning" }
  },
  "extensions": {
    "serviceBus": {
      "prefetchCount": 0,
      "autoCompleteMessages": true,
      "maxConcurrentCalls": 8,
      "maxAutoLockRenewalDuration": "00:05:00"
    }
  }
}
