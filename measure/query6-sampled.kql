requests
| where operation_Id in (ids)
| summarize Spans = count(), Roles = dcount(cloud_RoleName) by operation_Id
| summarize Traces = count(), Complete = countif(Spans >= 6), Partial = countif(Spans < 6), MinSpans = min(Spans), MaxSpans = max(Spans)

// Breakdown per role: which services kept spans for the sampled traces (should be all three for every kept trace)
requests
| where operation_Id in (ids)
| summarize Spans = count() by cloud_RoleName
